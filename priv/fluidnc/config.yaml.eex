# FluidNC config for this machine, the starting point for every controller.
# Generated by CNC.Boards from priv/fluidnc/config.yaml.eex:
# the machine (travel, speeds, homing) is written once here; the board fills
# in its pins, stepping engine and whether it has switches. After this, the
# controller's own config is the source of truth (its Configuration page).
#
# Ranges our app expects (machine travel): X/Y 0..1250, Z -100..0. FluidNC
# derives them from homing: toward the negative end with mpos_mm 0 gives
# 0..max_travel_mm, toward the positive end -max_travel_mm..0. So X/Y home
# negative (front-left) and Z homes up.
#
# steps_per_mm is a placeholder until the drive train is chosen
# (DM542T microstepping x motor steps / mm per rev).

name: "DHM CNC router"
board: "<%= @board %>"

stepping:
  engine: <%= @engine %>
  idle_ms: 255
  pulse_us: 4
  dir_delay_us: 1
  disable_delay_us: 0

axes:
<%= if @pins[:disable] do %>  shared_stepper_disable_pin: <%= @pins[:disable] %>

<% end %>  x:
    steps_per_mm: 80
    max_rate_mm_per_min: 3000
    acceleration_mm_per_sec2: 500
    max_travel_mm: 1250
    soft_limits: true
    homing:
      cycle: <%= if @switches?, do: 2, else: -1 %>
      positive_direction: false
      mpos_mm: 0
      feed_mm_per_min: 100
      seek_mm_per_min: 2000
      settle_ms: 250
    motor0:
<%= if @switches? do %>      limit_neg_pin: <%= @pins.x_limit %>
      hard_limits: true
<% else %>      hard_limits: false
<% end %>      pulloff_mm: 2
      standard_stepper:
        step_pin: <%= @pins.x_step %>
        direction_pin: <%= @pins.x_dir %>
<%= if @pins[:x_disable] do %>        disable_pin: <%= @pins.x_disable %>
<% end %>
  y:
    steps_per_mm: 80
    max_rate_mm_per_min: 3000
    acceleration_mm_per_sec2: 500
    max_travel_mm: 1250
    soft_limits: true
    homing:
      cycle: <%= if @switches?, do: 2, else: -1 %>
      positive_direction: false
      mpos_mm: 0
      feed_mm_per_min: 100
      seek_mm_per_min: 2000
      settle_ms: 250
    motor0:
<%= if @switches? do %>      limit_neg_pin: <%= @pins.y_limit %>
      hard_limits: true
<% else %>      hard_limits: false
<% end %>      pulloff_mm: 2
      standard_stepper:
        step_pin: <%= @pins.y_step %>
        direction_pin: <%= @pins.y_dir %>
<%= if @pins[:y_disable] do %>        disable_pin: <%= @pins.y_disable %>
<% end %>
  z:
    steps_per_mm: 400
    max_rate_mm_per_min: 1200
    acceleration_mm_per_sec2: 200
    max_travel_mm: 100
    soft_limits: true
    homing:
      cycle: <%= if @switches?, do: 1, else: -1 %>
      positive_direction: true
      mpos_mm: 0
      feed_mm_per_min: 100
      seek_mm_per_min: 600
      settle_ms: 250
    motor0:
<%= if @switches? do %>      limit_pos_pin: <%= @pins.z_limit %>
      hard_limits: true
<% else %>      hard_limits: false
<% end %>      pulloff_mm: 2
      standard_stepper:
        step_pin: <%= @pins.z_step %>
        direction_pin: <%= @pins.z_dir %>
<%= if @pins[:z_disable] do %>        disable_pin: <%= @pins.z_disable %>
<% end %><%= if @pins[:probe] do %>
probe:
  pin: <%= @pins.probe %>
<%= if @pins[:toolsetter] do %>  toolsetter_pin: <%= @pins.toolsetter %>
<% end %><% end %><%= if @extra do %>
<%= @extra %><% end %>
start:
  must_home: false
